<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#16A34A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0F0D</item>
        <item name="android:navigationBarColor">#0B0F0D</item>
        <item name="android:windowBackground">@drawable/dunta_splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">#0B0F0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>
</resources>
